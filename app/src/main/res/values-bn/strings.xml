    <!-- Battery Guide Dialog -->
    <string name="battery_guide_title">ব্যাটারি অপটিমাইজেশন গাইড</string>
    <string name="battery_guide_body">অনেক ফোনের সিস্টেম ব্যাকগ্রাউন্ড অ্যাপ বন্ধ করে দেয়। ক্লোন করা মেসেজিং বা ইমেইল অ্যাপের নোটিফিকেশন সময়মতো পেতে:\n\n১. নিচের সিস্টেম ব্যাটারি সেটিংস খুলুন।\n২. তালিকা থেকে CloneX খুঁজে বের করুন।\n৩. \"Unrestricted\" বা \"Don\'t optimize\" নির্বাচন করুন।\n\nCloneX শুধু সক্রিয় ক্লোনের প্রয়োজনেই রিসোর্স ব্যবহার করে।</string>
